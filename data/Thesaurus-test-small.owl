    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13199"/>
        <owl:annotatedProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#P97"/>
        <owl:annotatedTarget>Photosynthetic organelle containing chlorophyll, the photosynthetic pigment, in cells of leaves and young stems of higher plants. Lens-shaped and rather variable in size but approximately 5 m long. Surrounded by a double membrane and contains circular DNA (though not enough to code for all proteins in the chloroplast). Like the mitochondrion, it is semi-autonomous. It resembles a cyanobacterium from which, on the endosymbiont hypothesis, it might be derived. Chlorophyll is associated with the membrane of vesicles (thylakoids) that are stacked to form grana.</owl:annotatedTarget>
        <P378>NCI</P378>
        <P379>DEFAULT_Review</P379>
        <P380>060127</P380>
    </owl:Axiom>

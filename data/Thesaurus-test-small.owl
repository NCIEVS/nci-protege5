        <owl:annotatedProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#P97"/>
        <owl:annotatedTarget>A role used to relate a disease to the type of normal tissue in which the disease process began. The domain and the range for this role are &apos;Disease, Disorder or Finding&apos; and &apos;Anatomic Structure, System, or Substance&apos;, respectively.</owl:annotatedTarget>
        <P378>NCI</P378>
        <P379>Nicole Thomas</P379>
        <P380>110217</P380>
    </owl:Axiom>
    <owl:ObjectProperty rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R104">

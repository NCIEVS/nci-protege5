    <rdfs:Datatype rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#xref-source-enum">
        <default_on_create_class>IMDRF</default_on_create_class>
        <default_on_edit_class>IMDRF</default_on_edit_class>
